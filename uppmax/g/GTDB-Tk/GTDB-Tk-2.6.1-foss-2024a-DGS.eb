# - UPPMAX bioinfo toolchain 2024a
# - add Dataset dependency GTDB/R226 for its database

easyblock = 'PythonBundle'

name = 'GTDB-Tk'
version = '2.6.1'

homepage = 'https://github.com/Ecogenomics/GTDBTk'
description = "A toolkit for assigning objective taxonomic classifications to bacterial and archaeal genomes."

toolchain = {'name': 'foss', 'version': '2024a'}

dependencies = [
    ('Python', '3.12.3'),
    ('DendroPy', '4.6.1'),
    ('matplotlib', '3.9.2'),
    ('prodigal', '2.6.3'),
    ('HMMER', '3.4'),
    ('pplacer', '1.1.alpha19', '', SYSTEM),
    ('skani', '0.3.1', '', SYSTEM),
    ('FastTree', '2.1.11'),
    ('Mash', '2.3'),
    ('tqdm', '4.66.5'),
    ('pydantic', '1.10.13'),
    ('GTDB', 'R226', '', SYSTEM),   # Database for GTDB-Tk, 100+GB
]

local_linkdependencies = [
    toolchain,
]

exts_list = [
    ('gtdbtk', version, {
        'checksums': ['3b4a9622dcad5404678176c6776061aca3f478f5910999407df3fc7cc207370e'],
    }),
]

sanity_check_paths = {
    'files': ['bin/gtdbtk'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["gtdbtk --help"]

moduleclass = 'bio'
