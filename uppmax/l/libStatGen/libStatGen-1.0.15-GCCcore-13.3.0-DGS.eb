# This easyconfig was created by Simon Branford of the BEAR Software team at the University of Birmingham.
# Douglas G Scofield UPPMAX 6/2025
# update to uppmax bio toolchain, no new version released
#################################################
easyblock = 'MakeCp'

name = 'libStatGen'
version = '1.0.15'
_hash = 'ff4f2fc'

homepage = "https://genome.sph.umich.edu/wiki/C++_Library:_libStatGen"
description = """Useful set of classes for creating statistical genetic programs."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

github_account = 'statgen'
source_urls = [GITHUB_SOURCE]
sources = [{'download_filename': '%s.tar.gz' % _hash, 'filename': SOURCELOWER_TAR_GZ}]
checksums = ['68acb15b6c85f07b0dbf3f8b7a2a99a88fc97d3e29e80bebab82bd2a8e09121e']

builddependencies = [
    ('binutils', '2.42'),
]

dependencies = [
    ('zlib', '1.3.1'),
]

local_linkdependencies = [
    ('zlib', '1.3.1'),
    toolchain,
]

runtest = 'test'

keepsymlinks = False
files_to_copy = [
    (['%(name)s.a'], 'lib'),
    ('include'),
]

# some of the installed header files inexplicably have +x 
postinstallcmds = [ 'find %(installdir)s/include -type f -name "*.h" -print0 | xargs -0 chmod -x' ]

sanity_check_paths = {
    'files': [ 'lib/%(name)s.a',
               'include/VcfFile.h', 'include/SamFile.h', 'include/BamIndex.h', 'include/Cigar.h'
             ],
    'dirs': [],
}

moduleclass = 'bio'
