# Notes::
#
# Updated to 1.14 and gcc-11.2.0
# J. Sassmannshausen / GSTT
#
# Build using GCC 13.3.0 UPPMAX bio toolchain versions and including libdeflate
# D. G. Scofield / UPPMAX

name = 'SAMtools'
version = '1.19.2'

homepage = 'https://www.htslib.org/'
description = """SAM Tools provide various utilities for manipulating alignments in the SAM format, 
 including sorting, merging, indexing and generating alignments in a per-position format."""

toolchain = {'name': 'GCC', 'version': '13.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/%(namelower)s/%(namelower)s/releases/download/%(version)s']
sources = [SOURCELOWER_TAR_BZ2]
checksums = ['71f60499668e4c08e7d745fbff24c15cc8a0977abab1acd5d2bb419bdb065e96']

dependencies = [
    ('ncurses', '6.5'),
    ('libdeflate', '1.20'),
    ('zlib', '1.3.1'),
    ('bzip2', '1.0.8'),
    ('XZ', '5.4.5'),
    ('cURL', '8.7.1'),
]

local_linkdependencies = [
    ('ncurses', '6.5'),
    ('libdeflate', '1.20'),
    ('zlib', '1.3.1'),
    ('bzip2', '1.0.8'),
    ('XZ', '5.4.5'),
    ('cURL', '8.7.1'),
    toolchain,
]


moduleclass = 'bio'
