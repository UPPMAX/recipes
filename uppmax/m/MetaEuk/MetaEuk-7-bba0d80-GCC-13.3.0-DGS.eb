# Douglas Scofield UPPMAX 01/2026
# - new version, and switch to using version-commit like the tool does
# - UPPMAX bioinfo toolchain 2024a
###################################

easyblock = 'CMakeMake'

name = 'MetaEuk'

version = '7-bba0d80'  # include the commit in the version, just like the tool's own versioning

homepage = 'https://github.com/soedinglab/metaeuk'
description = """MetaEuk is a modular toolkit designed for large-scale gene discovery and annotation in eukaryotic
 metagenomic contigs."""

toolchain = {'name': 'GCC', 'version': '13.3.0'}

source_urls = ['https://github.com/soedinglab/%(namelower)s/archive']
sources = [ '%(version)s.tar.gz' ]
checksums = ['45eff3cb8e15626b1142d4717bf43a6e7a1308bc8a6eb1718c70d33d613898fa']

builddependencies = [
    ('CMake', '3.29.3'),
]

dependencies = [
    ('bzip2', '1.0.8'),
    ('zlib', '1.3.1'),
]

local_linkdependencies = [
    ('bzip2', '1.0.8'),
    ('zlib', '1.3.1'),
    toolchain,
]


sanity_check_paths = {
    'files': ['bin/metaeuk'],
    'dirs': [],
}

sanity_check_commands = ["metaeuk --help"]

moduleclass = 'bio'
