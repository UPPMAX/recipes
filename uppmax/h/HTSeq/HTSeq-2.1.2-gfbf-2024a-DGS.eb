# Updated to PythonBundle and latest version from Pypi
# Author: J. Sassmannshausen (Imperial College London/UK)
# Update: P.Tománek (Inuits)
#
# Douglas Scofield UPPMAX 02/2026
# - update version 2.1.2
# - lower toolchain to gfbf 2024a
#################################

easyblock = 'PythonBundle'

name = 'HTSeq'
version = '2.1.2'

homepage = 'https://github.com/htseq/htseq'
description = """HTSeq is a Python library to facilitate processing and analysis
 of data from high-throughput sequencing (HTS) experiments."""

toolchain = {'name': 'gfbf', 'version': '2024a'}

builddependencies = [('SWIG', '4.2.1')]

dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('Pysam', '0.22.1'),
    ('SciPy-bundle', '2024.05'),
    ('matplotlib', '3.9.2'),
]

local_linkdependencies = [
    toolchain,
]

exts_list = [
    ('htseq', version, {
        'modulename': 'HTSeq',
        'checksums': ['69d5a6b9a832ea85edf8a32fbac591a8af2e32bb961d1f3843c48c9d03a77a82'],
    }),
]

sanity_check_paths = {
    'files': ['bin/%(namelower)s-count', 'bin/%(namelower)s-qa'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/%(name)s/scripts'],
}

sanity_check_commands = ['%(namelower)s-count --help']

moduleclass = 'bio'
