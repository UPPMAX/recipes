# Douglas G Scofield UPPMAX 11/2025
# - remove dependency seqtk, it uses its modified internal version
#   and the mechanism has changed since 2.2.1
# - lower toolchain to gfbf, same as R/4.4.2
# - UPPMAX bio toolchain 2024a

easyblock = 'PythonPackage'

name = 'mapDamage'
version = '2.2.3'

github_account = 'ginolhac'

homepage = 'https://ginolhac.github.io/mapDamage/'
description = """mapDamage2 is a computational framework written in Python and
    R, which tracks and quantifies DNA damage patterns among ancient DNA
    sequencing reads generated by Next-Generation Sequencing platforms."""

toolchain = {'name': 'gfbf', 'version': '2024a'}

source_urls = [GITHUB_SOURCE]
sources = ['%(version)s.tar.gz']
checksums = [ 'a66cab24102405de4ae612701506de9724cde58c685a25e74880ef552d1f2d2b' ]

dependencies = [
    ('Python', '3.12.3'),
    ('Pysam', '0.22.1'),
    ('R', '4.4.2'),
]

local_linkdependencies = [
    toolchain,
]

sanity_check_commands = ['mapDamage --help']

moduleclass = 'bio'
