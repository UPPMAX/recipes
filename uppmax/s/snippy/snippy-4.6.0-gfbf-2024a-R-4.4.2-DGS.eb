# Douglas Scofield UPPMAX 04/2026
# - UPPMAX bioinfo toochain 2024a
# - little for link dependencies as all are used as executables
# - must use samtools earlier than 1.21
#################################

easyblock = 'Tarball'

name = 'snippy'
version = '4.6.0'
versionsuffix = '-R-%(rver)s'

homepage = 'https://github.com/tseemann/snippy'
description = "Rapid haploid variant calling and core genome alignment"

toolchain = {'name': 'gfbf', 'version': '2024a'}

source_urls = ['https://github.com/tseemann/snippy/archive/refs/tags/']
sources = ['v%(version)s.tar.gz']
checksums = ['7264e3819e249387effd3eba170ff49404b1cf7347dfa25944866f5aeb6b11c3']

dependencies = [
    ('R', '4.4.2'),
    ('Perl', '5.38.2'),
    ('BioPerl', '1.7.8'),
    ('BWA', '0.7.19'),
    ('BCFtools', '1.21.1'),
    ('BEDTools', '2.31.1'),
    ('SAMtools', '1.19.2'),
    ('parallel', '20240722'),
    ('minimap2', '2.30'),
    ('vt', '0.57721'),
    ('samclip', '0.4.0'),
    ('seqtk', '1.5'),
    ('snp-sites', '2.5.1'),
    ('snpEff', '5.2a', '-Java-17'),
    ('any2fasta', '0.8.1'),
    ('wgsim', '20111017'),
    ('freebayes', '1.3.7', versionsuffix)
]

local_linkdependencies = [
    toolchain,
]

sanity_check_paths = {
    'files': ['bin/snippy', 'perl5/Snippy/Version.pm'],
    'dirs': ['etc', 'test'],
}

sanity_check_commands = [
    "snippy --version",
    "snippy --check",
    "snippy --help",
]

moduleclass = 'bio'
