easyblock = 'PythonBundle'

name = 'bx-python'
version = '0.15.1'

homepage = 'https://github.com/bxlab/bx-python'
description = """The bx-python project is a Python library and associated set of scripts to allow for rapid
 implementation of genome scale analyses."""

toolchain = {'name': 'gfbf', 'version': '2026.1'}

builddependencies = [
    ('Cython', '3.2.4'),
]

dependencies = [
    ('Python', '3.14.2'),
    ('LZO', '2.10'), ####
    ('SciPy-bundle', '2026.05'),
]

exts_list = [
    ('python-lzo', '1.15', {
        'modulename': 'lzo',
        'preinstallopts': "export PREFIX=$EBROOTLZO && ",
        'checksums': ['a57aaa00c5c3a0515dd9f7426ba2cf601767dc19dc023d8b99d4a13b0a327b49'],
    }),
    (name, version, {
        'modulename': 'bx',
        'sources': ['bx_python-%(version)s.tar.gz'],
        'checksums': ['8c7102ffbf970139bcd792d320923b32f630ea20fde4898e9084c69b8ef06bb2'],
    }),
]

moduleclass = 'bio'
