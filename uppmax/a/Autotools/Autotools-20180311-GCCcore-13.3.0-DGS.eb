# Douglas Scofield UPPMAX 03/2026
# - resurrect from 4.9.4
# - required for building some older tools, e.g., Jellyfish/1.1.12
#################################

easyblock = 'Bundle'

name = 'Autotools'
version = '20180311'  # date of the most recent change

homepage = 'https://autotools.io'

description = """
 This bundle collect the standard GNU build tools: Autoconf, Automake
 and libtool
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

dependencies = [
    ('Autoconf', '2.69'),    # 20120424
    ('Automake', '1.16.1'),  # 20180311
    ('libtool', '2.4.6'),    # 20150215
]

# Pure bundle -- no need to specify 'binutils' used when building GCCcore
# toolchain as build dependency

moduleclass = 'devel'
