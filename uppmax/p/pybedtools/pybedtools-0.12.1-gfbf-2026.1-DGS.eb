easyblock = 'PythonPackage'

name = 'pybedtools'
version = '0.12.1'

homepage = 'https://daler.github.io/pybedtools'
description = "pybedtools wraps and extends BEDTools and offers feature-level manipulations from within Python."

toolchain = {'name': 'gfbf', 'version': '2026.1'}

sources = [SOURCE_TAR_GZ]
checksums = ['f459def3b430b4de6689a800d5d7b38beb313436cfb9d5e966600afca909415a']

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('BEDTools', '2.31.1'),
    ('Pysam', '0.24.0'),
]

local_linkdependencies = [
    toolchain,
]

moduleclass = 'bio'
