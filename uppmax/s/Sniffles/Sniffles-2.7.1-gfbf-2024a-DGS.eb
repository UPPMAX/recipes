easyblock = 'PythonBundle'

name = 'Sniffles'
version = '2.7.1'

homepage = 'https://github.com/fritzsedlazeck/Sniffles'
description = """A fast structural variant caller for long-read sequencing,
 Sniffles2 accurately detect SVs on germline, somatic and population-level for PacBio and Oxford Nanopore read data."""

toolchain = {'name': 'gfbf', 'version': '2024a'}

dependencies = [
    ('Python', '3.12.3'),
    ('Pysam', '0.22.1'),
    ('edlib', '1.3.9.post1'),
    ('Cython', '3.0.10'),
    ('meson-python', '0.16.0'),
    ('hypothesis', '6.103.1'),
]

local_linkdependencies = [
    toolchain,
]

exts_list = [
    ('spin', '0.14', {
        'checksums': ['1a5f6ce53699ef58bf893970ecb9d7f8814a8ca08da5d26e1391fe2a9fa04bcc'],
    }),
    ('numpy', '2.2.1', {
        'checksums': ['45681fd7128c8ad1c379f0ca0776a8b0c6583d2f69889ddac01559dfe4390918'],
    }),
    (name, version, {
        'sources': [SOURCELOWER_TAR_GZ],
        'checksums': ['76d1eece52648ca4d5f7668d518b28e88842dea7007e419ca3b07f81eeebc1fe'],
    }),
]

sanity_check_paths = {
    'files': ['bin/sniffles'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = [
    "python -c 'from sniffles import sv'",
    "sniffles --help",
]

moduleclass = 'bio'
