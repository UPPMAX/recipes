# Douglas G Scofield UPPMAX 6/2025
# - new version
# - UPPMAX bio toolchain
##############################

easyblock = 'PythonPackage'

name = 'Flye'
version = '2.9.6'

homepage = 'https://github.com/mikolmogorov/Flye'
description = """Flye is a de novo assembler for long and noisy reads, such as those produced by PacBio
 and Oxford Nanopore Technologies."""

toolchain = {'name': 'GCC', 'version': '13.3.0'}

github_account = 'mikolmogorov';
source_urls = [ GITHUB_SOURCE + '/refs/tags' ]
sources = ['%(version)s.tar.gz']
checksums = ['f05a3889b1c7aafed4cc0ed1adc1f19c22618c1c7b97ab5f80d388c8192bd32a']

dependencies = [
    ('Python', '3.12.3'),
]

local_linkdependencies = [
    toolchain,
]

if ARCH == "aarch64":
    preinstallopts = 'export arm_neon=1 && export aarch64=1 && '

sanity_check_paths = {
    'files': ['bin/flye'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ['%(namelower)s --help']

moduleclass = 'bio'
