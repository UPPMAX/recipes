# Douglas Scofield UPPMAX 01/2026
# - support its *.lua scripts using LuaJIT
# - support its *.js scripts using k8
#################################

easyblock = 'MakeCp'

name = 'psmc'
version = '0.6.5_20251117'
_commit = '82fa2ad'

homepage = 'https://github.com/lh3/psmc'
description = """This software package infers population size history from a diploid sequence
using the Pairwise Sequentially Markovian Coalescent (PSMC) model."""

toolchain = {'name': 'GCC', 'version': '13.3.0'}

source_urls = ['https://github.com/lh3/psmc/archive/']
sources = [{
    'source_urls': ['https://github.com/lh3/psmc/archive/'],
    'download_filename': '%s.tar.gz' % _commit,
    'filename': SOURCE_TAR_GZ,
}]
checksums = ['a996c8f377255451037b52b9d550fa0da0c12180d7579db0469d39cb8a8d5e52']

dependencies = [
    ('Perl', '5.38.2'),
    ('k8', '1.2'),
    ('LuaJIT', '2.1.ROLLING_20260109'),
]

local_linkdependencies = [
    toolchain,
]

buildopts = '&& cd utils && make'

local_utils = [
    'avg.pl', 'calD', 'cntcpg', 'ctime_plot.pl', 'dec2ctime.pl', 'dec2img.js', 'decode2bed.pl',
    'fq2psmcfa', 'history2ms.pl', 'ms2psmcfa.pl', 'mutDiff', 'pcnt_bezier.lua', 'psmc2history.pl',
    'psmc_plot.pl', 'psmc_trunc.pl', 'split-time.js', 'splitfa', 'vcf2snp.pl',
]

files_to_copy = [
    (['psmc'], 'bin'),
    (['utils/%s' % x for x in local_utils], 'bin')
]

postinstallcmds = [
    # recommended help, see perldoc Getopt::Std
    "sed -i '/use Getopt::Std;/a $Getopt::Std::STANDARD_HELP_VERSION = 1;' %(installdir)s/bin/*.pl",
    "sed -i '1i#!/usr/bin/env k8' %(installdir)s/bin/dec2img.js",
] + [ "chmod +x %%(installdir)s/bin/*.%s" % x for x in [ 'pl', 'js', 'lua' ] ]

fix_perl_shebang_for = ['bin/*.pl']

sanity_check_paths = {
    'files': ['bin/psmc'] + ['bin/%s' % x for x in local_utils],
    'dirs': [],
}

sanity_check_commands = [
    'psmc 2>&1 |grep "Usage:"',
    'calD 2>&1 |grep "Usage:"',
    'avg.pl --help',
    'ctime_plot.pl --help',
]

moduleclass = 'bio'
