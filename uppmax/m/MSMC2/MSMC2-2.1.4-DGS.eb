# Douglas G Scofield UPPMAX 12/2025
# - download prebuilt binaries (source written in D)
# - place in bin/ and symlink namelower to download name
####################################################

easyblock = 'Binary'

name = 'MSMC2'
version = '2.1.4'

homepage = 'https://github.com/stschiff/msmc2'
description = """
This program implements MSMC2, a method to infer population size history and population separation history from whole genome sequencing data.
SHAPEIT5 is a software package to estimate haplotypes in large genotype datasets, with a special focus on rare variants.
"""

toolchain = SYSTEM

github_account = 'stschiff'
source_urls = [GITHUB_LOWER_RELEASE]

github_account = 'stschiff'
_source_prefix  = '%(namelower)s'
_source         = _source_prefix + '_Linux'
_source_version = _source        + '-%(version)s'
checksums = [ '210d04d6ecfbe653890ebf34bc5cdc95032293ff1873ae79d22ec2e2b6ca3192' ]

sources = [{
    'source_urls': [ GITHUB_LOWER_RELEASE ],
    'filename': _source_version,
    'download_filename': _source,
    'extract_cmd': 'cp %s %(builddir)s/',
}]

extract_sources = False

# install the files using their original names, make them executable, and create a symlink to each without the suffix _static
# note changes in strings between phrases so everything concatenates sanely
install_cmd =  'mkdir %(installdir)s/bin && '
install_cmd += 'cp ' + _source_version + ' %(installdir)s/bin/' + _source + ' && '
install_cmd += 'cd %(installdir)s/bin && '
install_cmd += 'chmod +x ' + _source + ' && '
install_cmd += 'ln -s ' + _source + ' %(namelower)s'

sanity_check_paths = {
    'files': [ 'bin/%(namelower)s' ],
    'dirs' : [ ]
}

sanity_check_commands = [ '%(namelower)s 2>&1 | grep "version %(version)s"' ]

moduleclass = 'bio'
