# Douglas Scofield UPPMAX 10/2026
# - UPPMAX bioinfo toolchain 2026.1
# - fiddle with exts to match gffutils/0.14 and others in bioinfo toolchain
# - add future to exts
# - adjust requirements to allow matplotlib/3.10.9
################################

easyblock = 'PythonBundle'

name = 'pyGenomeTracks'
version = '3.9'

homepage = 'https://pygenometracks.readthedocs.io'
description = "pyGenomeTracks aims to produce high-quality genome browser tracks that are highly customizable."

toolchain = {'name': 'foss', 'version': '2026.1'}

dependencies = [
    ('Python', '3.14.2'),
    ('SciPy-bundle', '2026.05'),
    ('matplotlib', '3.10.9'),
    ('bx-python', '0.15.1'),
    ('pybedtools', '0.12.1', '', {'name': 'gfbf', 'version': '2026.1'}),
    ('pyBigWig', '0.3.26'),
    ('pyfaidx', '0.9.0.4'),
    ('Pysam', '0.24.0'),
    ('tqdm', '4.67.3'),
    ('PyTables', '3.11.1'),
    ('h5py', '3.16.0'),
    ('PyYAML', '6.0.3'),
    ('cooler', '0.10.4'),
    ('HiCMatrix', '17.2'),
]

local_linkdependencies = [
    toolchain,
]

exts_list = [
    ('future', '1.0.0', {
        'source_tmpl': SOURCE_PY3_WHL,
        'checksums': ['929292d34f5872e70396626ef385ec22355a1fae8ad29e1a734c3e43f9fbc216'],
    }),
    ('argcomplete', '3.7.2', {
        'source_tmpl': SOURCE_PY3_WHL,
        'checksums': ['6029205678bdd9c1c728a155f5f9ecf5812393f969eef58807641a2bc2aa5b19'],
    }),
    ('argh', '0.31.3', {
        'source_tmpl': SOURCE_PY3_WHL,
        'checksums': ['2edac856ff50126f6e47d884751328c9f466bacbbb6cbfdac322053d94705494'],
    }),
    ('gffutils', '0.14', {
        'source_tmpl': SOURCE_PY3_WHL,
        'checksums': ['999320d7b44357d59afc6d1ff8e92d8565147bf3ad497786c4e7fd86b1b78754'],
    }),
    ('pypairix', '0.3.9', {
        'checksums': ['a1dc8b11b35ab6b7763935898ec45abf422e060517295a1dadc33b6e9eaad03a'],
    }),
    (name, version, {
        'source_tmpl': '%(version)s.tar.gz',
        'source_urls': ['https://github.com/deeptools/pyGenomeTracks/archive/refs/tags'],
        'checksums': ['4318cb642422ee16d83675d571f4cd49b14784d7ee135ab53d8946fc7ad663f6'],
        'preinstallopts': "sed -i 's|matplotlib >=3.1.1,<3.9|matplotlib >=3.1.1,<=3.10.9|' pyproject.toml && sed -i 's|matplotlib >=3.1.1,<3.9|matplotlib >=3.1.1,<=3.10.9|' requirements.txt && "
    }),
]


sanity_check_paths = {
    'files': ['bin/pyGenomeTracks'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["pyGenomeTracks --help"]

moduleclass = 'bio'
