#
# Douglas Scofield UPPMAX 10/2026
# - movied forward 1.22.1 changes from 13.3.0
# - no longer producing hfile_s3_write.so
# - security bugfix version
# - Enable libdeflate libcurl plugins and cloud
# - UPPMAX bioinfo toolchain 2024a
#################################

easyblock = 'ConfigureMake'

name = 'HTSlib'
version = '1.23.1'

homepage = 'https://www.htslib.org/'
description = """A C library for reading/writing high-throughput sequencing data.
 This package includes the utilities bgzip and tabix"""

toolchain = {'name': 'GCC', 'version': '15.2.0'}

source_urls = ['https://github.com/samtools/%(namelower)s/releases/download/%(version)s/']
sources = [SOURCELOWER_TAR_BZ2]
checksums = ['f8a3f36effeec38f043c53ab1f2d9ed45064f14205c5ef8e3c815763b90803c4']

dependencies = [
    ('zlib',        '2.3.2'),
    ('bzip2',       '1.0.8'),
    ('XZ',          '5.8.2'),
    ('cURL',        '8.17.0'),
    ('libdeflate',  '1.25'),
]

local_linkdependencies = [
    ('zlib',        '1.3.1'),
    ('bzip2',       '1.0.8'),
    ('XZ',          '5.4.5'),
    ('cURL',        '8.7.1'),
    ('libdeflate',  '1.20'),
    toolchain,
]

configopts = "--with-libdeflate --enable-libcurl --enable-plugins --enable-s3 --enable-gcs"

sanity_check_paths = {
    'files': ['bin/annot-tsv', 'bin/bgzip', 'bin/htsfile', 'bin/tabix',
              'include/htslib/hts.h',
              'lib/libhts.a', 'lib/libhts.%s' % SHLIB_EXT,
              'libexec/htslib/hfile_gcs.%s' % SHLIB_EXT,
              'libexec/htslib/hfile_libcurl.%s' % SHLIB_EXT,
              'libexec/htslib/hfile_s3.%s' % SHLIB_EXT,
             ],
    'dirs': [],
}

moduleclass = 'bio'
