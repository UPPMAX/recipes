#
# Author: Jonas Demeulemeester
# The Francis Crick Insitute, London, UK
#
# Douglas Scofield UPPMAX 03/2026
# - security bugfix versions (HTSlib update too)
# - UPPMAX bioinfo toolchain 2024a
#################################

easyblock = 'ConfigureMake'

name = 'BCFtools'
version = '1.22.1'

homepage = 'https://www.htslib.org/'
description = """Samtools is a suite of programs for interacting with high-throughput sequencing data.
 BCFtools - Reading/writing BCF2/VCF/gVCF files and calling/filtering/summarising SNP and short indel sequence
 variants"""

toolchain = {'name': 'GCC', 'version': '13.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/samtools/%(namelower)s/releases/download/%(version)s']
sources = [SOURCELOWER_TAR_BZ2]
checksums = ['4b501b00091da6283565de2a7108b8c4ecda7ceb63c86c8e399c03b973ca483a']

dependencies = [
    ('zlib',   '1.3.1'),
    ('bzip2',  '1.0.8'),
    ('XZ',     '5.4.5'),
    ('GSL',    '2.8'),
    ('HTSlib', '1.22.1'),
    ('Perl',   '5.38.2'),
]

local_linkdependencies = [
    ('zlib',   '1.3.1'),
    ('bzip2',  '1.0.8'),
    ('XZ',     '5.4.5'),
    ('GSL',    '2.8'),
    ('HTSlib', '1.22.1'),
    toolchain,
]

configopts = "--with-htslib=$EBROOTHTSLIB --enable-perl-filters --enable-libgsl"
buildopts = " USE_GPL=1 GSL_LIBS='-lgsl -lgslcblas'"


sanity_check_paths = {
    'files': ['bin/%(namelower)s', 'bin/plot-vcfstats', 'bin/vcfutils.pl'],
    'dirs': ['libexec/%(namelower)s'],
}

moduleclass = 'bio'
