# Douglas G Scofield UPPMAX 5/2026
# - plumped up description, installed docs, sanity check version
# - include version suffix which existing EB recipe includes
#############################################

easyblock = 'Tarball'

name = 'ADMIXTURE'
version = '1.4.0'
versionsuffix = '-x86_64'

homepage = 'https://dalexander.github.io/admixture/'
description = """ADMIXTURE is a software tool for maximum likelihood estimation
of individual ancestries from multilocus SNP genotype datasets. It uses the
same statistical model as STRUCTURE but calculates estimates much more rapidly
using a fast numerical optimization algorithm.

PDF manual available at $EBROOTADMIXTURE/doc/admixture-manual.pdf

Specifically, ADMIXTURE uses a block relaxation approach to alternately update
allele frequency and ancestry fraction parameters. Each block update is handled
by solving a large number of independent convex optimization problems, which
are tackled using a fast sequential quadratic programming algorithm.
Convergence of the algorithm is accelerated using a novel quasi-Newton
acceleration method. The algorithm outperforms EM algorithms and MCMC sampling
methods by a wide margin. For details, see our publications:

D.H. Alexander, J. Novembre, and K. Lange. Fast model-based estimation of
ancestry in unrelated individuals. Genome Research, 19:1655-1664, 2009.

H. Zhou, D. H. Alexander, and K.  Lange. A quasi-Newton method for accelerating
the convergence of iterative optimization algorithms. Statistics and Computing,
2009."""

toolchain = SYSTEM

source_urls = ['https://dalexander.github.io/admixture/binaries/']
sources = ['%(namelower)s_linux-%(version)s.tar.gz']
checksums = ['5520c4f18525f49ab2c715d711b40f4a0818ef1485361a94ec8954d1364e6f19']

local_bins = [ 'admixture' ]
local_docs = [ 'admixture-manual.pdf' ]

postinstallcmds = [ 'mkdir %(installdir)s/{bin,doc}' ]
postinstallcmds += [ 'mv %%(installdir)s/%s %%(installdir)s/bin/' % x for x in local_bins ]
postinstallcmds += [ 'mv %%(installdir)s/%s %%(installdir)s/doc/' % x for x in local_docs ]

sanity_check_paths = {
    'files': (
        [ 'bin/%s' % x for x in local_bins ] + 
        [ 'doc/%s' % x for x in local_docs ]
    ),
    'dirs': []
}

sanity_check_commands = [ '%s --help | grep -F "ADMIXTURE Version %%(version)s"' % x for x in local_bins ]

moduleclass = 'bio'
