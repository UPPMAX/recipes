# Update to version 5.0 with test-jobs enabled.
# Based of previous 4.x build as template
# Author: J. Saßmannshausen (Imperial College London/UK)
#
# Douglas Scofield UPPMAX 04/2026
# - update version
# - update patch
#################################

easyblock = 'CMakeMake'

name = 'SLiM'
version = '5.1'

homepage = 'https://messerlab.org/slim'
description = """SLiM is an evolutionary simulation framework that combines
a powerful engine for population genetic simulations with the capability of
modeling arbitrarily complex evolutionary scenarios."""

toolchain = {'name': 'gfbf', 'version': '2024a'}

source_urls = ['https://github.com/MesserLab/%(name)s/archive']
sources = ['v%(version)s.tar.gz']
patches = [
    f'{name}-{version}_cmake_use_external_zlib_gsl.patch',
]
checksums = [
    {'v%(version)s.tar.gz': 'e8341014271d12cd872c78738c4c80e57864fb0fb2e33b44ae6b7aedf364fc56'},
    {'%(name)s-%(version)s_cmake_use_external_zlib_gsl.patch':
     '6bb9e5a8c2925436d041f1a84db72818ca5dd02516f210ffdd414dda86578308'},
]

builddependencies = [
    ('CMake', '3.29.3'),
]

dependencies = [
    ('zlib', '1.3.1'),
    ('GSL', '2.8'),
    ('Mesa', '24.1.3'),
    ('libglvnd', '1.7.0'),
    ('Qt6', '6.7.2'),
]

local_linkdependencies = [
    ('zlib', '1.3.1'),
    ('GSL', '2.8'),
    ('Mesa', '24.1.3'),
    ('libglvnd', '1.7.0'),
    ('Qt6', '6.7.2'),
    toolchain,
]

configopts = '-DBUILD_SLIMGUI=ON '

runtest = 'test'

sanity_check_paths = {
    'files': ['bin/eidos', 'bin/slim'],
    'dirs': [],
}

sanity_check_commands = [
    "eidos -usage",
    "eidos -testEidos",
    "slim -usage",
    "slim -testSLiM",
]

moduleclass = 'tools'
