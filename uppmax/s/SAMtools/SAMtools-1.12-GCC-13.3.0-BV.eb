# Build using GCC 13.3.0 UPPMAX bio toolchain versions
# BV / UPPMAX

name = 'SAMtools'
version = '1.12'

homepage = 'https://www.htslib.org/'
description = """SAM Tools provide various utilities for manipulating alignments in the SAM format, 
 including sorting, merging, indexing and generating alignments in a per-position format."""

toolchain = {'name': 'GCC', 'version': '13.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/%(namelower)s/%(namelower)s/releases/download/%(version)s']
sources = [SOURCELOWER_TAR_BZ2]
checksums = ['6da3770563b1c545ca8bdf78cf535e6d1753d6383983c7929245d5dba2902dcb']

dependencies = [
    ('ncurses', '6.5'),
    ('zlib', '1.3.1'),
    ('bzip2', '1.0.8'),
    ('XZ', '5.4.5'),
    ('cURL', '8.7.1'),
]

local_linkdependencies = [
    ('ncurses', '6.5'),
    ('zlib', '1.3.1'),
    ('bzip2', '1.0.8'),
    ('XZ', '5.4.5'),
    ('cURL', '8.7.1'),
    toolchain,
]

moduleclass = 'bio'
