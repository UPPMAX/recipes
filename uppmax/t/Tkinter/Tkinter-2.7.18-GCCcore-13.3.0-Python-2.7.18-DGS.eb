name = 'Tkinter'
version = '2.7.18'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://python.org/'
description = """Tkinter module, built with the Python buildsystem"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://www.python.org/ftp/python/%(version)s/']
sources = ['Python-%(version)s.tgz']
checksums = ['da3080e3b488f648a3d7a4560ddee895284c3380b11d6de75edb986526b9a814']

builddependencies = [
    ('binutils', '2.42'),
    ('pkgconf', '2.2.0'),
]

dependencies = [
    ('Python', version),
    ('Tk', '8.6.14'),
    ('zlib', '1.3.1'),
    ('bzip2', '1.0.8'),
    ('libreadline', '8.2'),
]

local_linkdependencies = [
    ('zlib', '1.3.1'),
    ('bzip2', '1.0.8'),
    ('libreadline', '8.2'),
    toolchain,
]

moduleclass = 'lang'
