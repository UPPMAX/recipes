download_instructions = f'Download {sources[0]} from mathworks.com'

java_options = '-Xmx2048m'

osdependencies = [('p7zip-plugins', 'p7zip-full')]  # for extracting iso-files
dependencies = [('MathWorksServiceHost', '2024.13.0.2')]

