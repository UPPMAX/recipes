    ('%(namelower)s', version, {
        #'source_urls': ['https://files.pythonhosted.org/packages/9d/3a/da74b95843069d317a1f35328ba449a0066cf6ade20edcf231b6edf0d26b/'],
        'sources': ['%(name)s-%(version)s-py2.py3-none-any.whl'],
        'checksums': ['1ab5e1800a7dbf8806b5f826301028df84321aabd02bd99b0184d5b464d535e7'],
        'modulename': 'bmtk',
    }),
    ('pynrrd', '1.1.3', {
        'modulename': 'nrrd',
        'checksums': ['a331263bc9f05c3168182e61d6098e256a34e0fadbb7427a1d086d8942fbcbe0'],
    }),
    ('nptyping', '2.5.0', {
        #'source_urls': ['https://github.com/ramonhagenaars/nptyping/archive/refs/tags/'],
        # 7f061750bcbda8ce3926fc22c22c372c9cebfdb9b889376c71cb5d911173660d
