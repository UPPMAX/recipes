# This file is an EasyBuild reciPY as per https://github.com/easybuilders/easybuild
# Author: Pablo Escobar Lopez
# Swiss Institute of Bioinformatics
# Biozentrum - University of Basel
# Modified by Adam Huffman
# Francis Crick Institute
#
# Douglas Scofield UPPMAX 03/2026
# - original download URL no longer works

easyblock = 'ConfigureMake'

name = 'Clustal-Omega'
version = '1.2.4'

homepage = 'https://github.com/GSLBiotech/clustal-omega'
description = """ Clustal Omega is a multiple sequence alignment
program for proteins. It produces biologically meaningful multiple
sequence alignments of divergent sequences. Evolutionary relationships
can be seen via viewing Cladograms or Phylograms.

    The original homepage is no longer available."""

toolchain = {'name': 'GCC', 'version': '13.3.0'}
toolchainopts = {'openmp': True}

github_account = 'GSLBiotech'
source_urls = [ 'https://github.com/%(github_account)s/%(namelower)s/archive/refs/tags' ]
sources = [ '%(version)s-cmake.tar.gz' ]
checksums = [ '60703b3994a12b30725cdedd41d4b9871098728ef9406f2e389fc2d8b61792de' ]

dependencies = [
    ('argtable', '2.13'),
]

local_linkdependencies = [
    ('argtable', '2.13'),
    toolchain,
]

sanity_check_paths = {
    'files': ['bin/clustalo'],
    'dirs': [],
}

sanity_check_commands = ["clustalo --help"]

moduleclass = 'bio'
