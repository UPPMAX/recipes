# Douglas Scofield UPPMAX 10/2026
# - bring from 2024a to 2026.1
# - UPPMAX bioinfo toolchain 2026.1
#################################

easyblock = 'PythonPackage'

name = 'Unidecode'
version = '1.4.0'

homepage = 'https://github.com/avian2/unidecode'
description = "Python library for lossy ASCII transliterations of Unicode text (port of Text::Unidecode Perl module)"

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['ce35985008338b676573023acc382d62c264f307c8f7963733405add37ea2b23']

builddependencies = [
    ('binutils', '2.45'),
]

dependencies = [
    ('Python', '3.14.2'),
]

local_linkdependencies = [
    toolchain,
]

fix_python_shebang_for = ['bin/unidecode']

sanity_check_paths = {
    'files': ['bin/unidecode'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["unidecode -h"]

moduleclass = 'lib'
