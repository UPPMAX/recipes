# Douglas Scofield UPPMAX 01/2026
# - new tool
# - UPPMAX bioinfo toolchain 2024a
# - be sure to update the build number in the grep in sanity_check_commands
#####################################

easyblock = 'MakeCp'

name = 'minigraph'
version = '0.21'

homepage = 'https://github.com/lh3/minigraph'
description = """Minigraph is a sequence-to-graph mapper and graph constructor. For graph
generation, it aligns a query sequence against a sequence graph and
incrementally augments an existing graph with long query subsequences diverged
from the graph."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

github_account = 'lh3'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['4272447393f0ae1e656376abe144de96cbafc777414d4c496f735dd4a6d3c06a']

builddependencies = [
    ('binutils', '2.42'),
]

dependencies = [
    ('zlib', '1.3.1'),
    ('k8', '1.2'),  # for the *.js files in misc/
]

local_linkdependencies = [
    ('zlib', '1.3.1'),
    toolchain,
]

files_to_copy = [
    (['%(name)s.1'], 'share/man/man1'),
    (['%(name)s'], 'bin'),
    (['misc/*.js'], 'bin'),
    'README.md',
    'LICENSE.txt',
]

modextrapaths = {
    'MANPATH': 'share/man',
}

sanity_check_paths = {
    'files': ['bin/%(name)s', 'bin/gafcall.js'],
    'dirs': ['share'],
}

sanity_check_commands = ['%(name)s --version | grep "%(version)s-r606"']

moduleclass = 'bio'
