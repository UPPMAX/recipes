# This file is an EasyBuild reciPY as per https://github.com/easybuilders/easybuild
# Author: Pablo Escobar Lopez
# Swiss Institute of Bioinformatics
# Biozentrum - University of Basel
# 1.4 modified by:
# Adam Huffman, Jonas Demeulemeester
# The Francis Crick Institute
# Updated to 1.14
# J. Sassmannshausen /GSTT
#
# version 1.13
# Build enabling plugins and cloud and using GCC 13.3.0 UPPMAX bio toolchain versions
# D. G. Scofield / UPPMAX

easyblock = 'ConfigureMake'

name = 'HTSlib'
version = '1.13'

homepage = "https://www.htslib.org/"
description = """A C library for reading/writing high-throughput sequencing data.
 This package includes the utilities bgzip and tabix"""

toolchain = {'name': 'GCC', 'version': '13.3.0'}

source_urls = ['https://github.com/samtools/%(namelower)s/releases/download/%(version)s/']
sources = [SOURCELOWER_TAR_BZ2]
checksums = ['f2407df9f97f0bb6b07656579e41a1ca5100464067b6b21bf962a2ea4b0efd65']

dependencies = [
    ('zlib',   '1.3.1'),
    ('bzip2',  '1.0.8'),
    ('XZ',     '5.4.5'),
    ('cURL',   '8.7.1'),
]

local_linkdependencies = [
    ('zlib',   '1.3.1'),
    ('bzip2',  '1.0.8'),
    ('XZ',     '5.4.5'),
    ('cURL',   '8.7.1'),
    toolchain,
]

configopts = "--enable-libcurl --enable-plugins --enable-s3 --enable-gcs"

sanity_check_paths = {
    'files': ['bin/bgzip', 'bin/htsfile', 'bin/tabix',
              'include/htslib/hts.h',
              'lib/libhts.a', 'lib/libhts.%s' % SHLIB_EXT,
              'libexec/htslib/hfile_gcs.%s' % SHLIB_EXT, 'libexec/htslib/hfile_libcurl.%s' % SHLIB_EXT, 'libexec/htslib/hfile_s3.%s' % SHLIB_EXT, 'libexec/htslib/hfile_s3_write.%s' % SHLIB_EXT],
    'dirs': [],
}

moduleclass = 'bio'
