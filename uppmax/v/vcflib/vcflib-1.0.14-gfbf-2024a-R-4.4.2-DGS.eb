# Author: Jasper Grimm (UoY)
# Updated: Denis Kristak (INUITS)
# Updated: Petr Král (INUITS)
#
# Douglas Scofield UPPMAX 01/2026
# - UPPMAX bioinfo toolchain 2024a
# - add dependency zig 0.13.0 and change to -DZIG=ON
# - differently from 1.0.9, build from git clone --recursive, removing rarely-used developer-specific tools
#   - intervaltree/0.1
#   - fastahack/1.0.0
#   - filevercmp/20191210
#   - fsom/20151117
#   - multichoose/1.0.3
#   - smithwaterman/20160702
# - above necessitates adding include/vcflib to CPATH
# - keeping additional modules for tabixpp/1.1.2 and WFA/2.3.4, solid tools/library
# - use module for HTSlib
# - might switch back for 1.0.15, freebayes appears to expects external trees, testing will determine
####################################

easyblock = 'CMakeMake'

name = 'vcflib'
version = '1.0.14'
versionsuffix = '-R-%(rver)s'

homepage = 'https://github.com/vcflib/vcflib'
description = """vcflib provides methods to manipulate and interpret sequence variation as it can be
 described by VCF. The Variant Call Format (VCF) is a flat-file, tab-delimited textual format intended
 to concisely describe reference-indexed genetic variations between individuals.

Note that the additional utility scripts provided at $EBROOTVCFLIB/scripts/ are rather informal. Many
may be run directly while some require the use of a Perl, Python or R interpreter. See their source
files for additional details."""

toolchain = {'name': 'gfbf', 'version': '2024a'}
toolchainopts = {'openmp': True}

sources = [{
    'filename': '%(name)s-v%(version)s-clone-recursive.tar.gz',
    'git_config': {
        'url': 'https://github.com/vcflib',
        'repo_name': 'vcflib',
        'tag': 'v%(version)s',
        'recursive': True,
        'keep_git_dir': True,
    }
}]
checksums = [None]


builddependencies = [
    ('CMake', '3.29.3'),
    ('pkgconf', '2.2.0'),
    ('pybind11', '2.12.0'),
    ('Pandoc', '3.1.13', '', SYSTEM),
    ('zig', '0.13.0', '', SYSTEM),
]

dependencies = [
    ('Python', '3.12.3'),
    ('Perl', '5.38.2'),
    ('R', '4.4.2'),
    ('XZ', '5.4.5'),
    ('zlib', '1.3.1'),
    ('bzip2', '1.0.8'),
    ('WFA2', '2.3.5'),
    ('tabixpp', '1.1.2'),
    ('HTSlib', '1.21.1'),
]

local_linkdependencies = [
    ('XZ', '5.4.5'),
    ('zlib', '1.3.1'),
    ('bzip2', '1.0.8'),
    ('WFA2', '2.3.5'),
    toolchain,
]

configopts =  " -DZIG=ON "
configopts += " -DWFA_GITMODULE=OFF "
configopts += " -DPYTHON_EXECUTABLE=$EBROOTPYTHON/bin/python "

postinstallcmds = ["cp -r %(builddir)s/%(name)s/scripts %(installdir)s/"]

#test_cmd = 'ctest'  # tests fail here, unable to import pyvcflib, but it works below during sanity check

modextrapaths = {
    'PATH': 'scripts',
    'CPATH': 'include/vcflib',
    'PYTHONPATH': 'lib',
    'MANPATH': 'share/man',
}

sanity_check_paths = {
    'files': ['bin/vcffilter', 'bin/vcfcombine', 'lib/libvcflib.%s' % SHLIB_EXT],
    'dirs': ['scripts', 'include'],
}

sanity_check_commands = [
    "python -c 'import pyvcflib'",
    "vcfwave --help",
]

moduleclass = 'bio'
